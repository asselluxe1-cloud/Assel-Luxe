name: Kaspi Price Update

on:
  schedule:
    - cron: "0 * * * *"

  workflow_dispatch:

permissions:
  contents: write

jobs:
  generate-kaspi-xml:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Generate Kaspi XML
        run: python generate_price.py

      - name: Commit XML
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add kaspi.xml

          if git diff --cached --quiet; then
            echo "No changes"
          else
            git commit -m "Update Kaspi price XML"
            git push
          fi
